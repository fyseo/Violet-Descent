                  </padding>
               </Label>
            </top>
            <center>
               <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="329.0" minWidth="200.0" prefHeight="329.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
                  <children>
                      <Button fx:id="StartButton" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" onAction="#onStartGameClick" prefHeight="60.0" styleClass="sketchy" text="_START GAME" textFill="WHITE" />
                     <Button fx:id="LoadButton" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" onAction="#setOnContinueButtonClick" prefHeight="60.0" styleClass="sketchy" text="_CONTINUE" textFill="WHITE" />
