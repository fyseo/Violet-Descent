<Pane prefHeight="538.0" prefWidth="1000.0" stylesheets="@../CSS/sketchy.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.crawler.GameController">
   <children>
