                     <Button fx:id="SettingsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSettingsButtonClick" prefHeight="60.0" styleClass="sketchy" text="SETTINGS" />
                     <Button fx:id="ExitButton" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" onAction="#onExitClick" prefHeight="60.0" styleClass="sketchy" text="_EXIT" textFill="WHITE" />
